# Local lab credentials only.
MYSQL_ROOT_PASSWORD=rootpass
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpresspass

# These values are used only by the local proxy example.
# Keep port 8666 consistent with traefik/wordpress.yml.
PROXY_NAME=wordpress
PROXY_LISTEN=0.0.0.0:8666
PROXY_UPSTREAM=wordpress:80

ENABLE_LATENCY=false
LATENCY_MS=200
LATENCY_JITTER=50
ENABLE_BANDWIDTH=false
BANDWIDTH_KBPS=100
ENABLE_TIMEOUT=false
TIMEOUT_MS=1000
ENABLE_SLOW_CLOSE=false
SLOW_CLOSE_MS=1000
