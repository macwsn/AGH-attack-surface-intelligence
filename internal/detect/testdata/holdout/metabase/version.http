    <script type="application/json" id="_metabaseLocalization">
      {"headers":{"language":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"translations":{"":{"Metabase":{"msgid":"Metabase","msgstr":["Metabase"]}}}}
