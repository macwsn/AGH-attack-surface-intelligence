                                    <input class="form-control" type="text" name="username"  maxlength="50" id="u01" value="" placeholder="username" >
                                    <span style="position: absolute"><i class="fa fa-user"></i></span>
                                </div>
                                <div class="jive-input-box">
                                    <input class="form-control" type="password" name="password" maxlength="50" id="p01" placeholder="password" >
                                    <span style="position: absolute"><i class="fa fa-key"></i></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 ">
